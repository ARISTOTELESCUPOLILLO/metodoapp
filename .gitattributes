# Normaliza quebra de linha para LF em todo arquivo de texto, independente
# do core.autocrlf da máquina que faz o checkout (Windows costuma converter
# para CRLF, o que conflita com o prettier — endOfLine padrão "lf").
* text=auto eol=lf

*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Binários — nunca tocar em quebra de linha.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
*.gif binary

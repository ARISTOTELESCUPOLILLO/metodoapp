{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metodo-op",
  "account_id": "17247f43dbdfa8dc34da28ed25f8fe8c",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "limits": {
    "cpu_ms": 300000
  },
  "alias": {
    "tanstack-start-injected-head-scripts:v": "./src/lib/empty.ts",
    "tanstack-start-manifest:v": "./src/lib/empty.ts"
  },
  "routes": [
    {
      "pattern": "metodoapp.oficinadepropaganda.com.br/*",
      "zone_name": "oficinadepropaganda.com.br"
    }
  ]
}
